{
  "name": "ionic-app",
  "version": "0.0.1",
  "author": "Ionic Framework",
  "homepage": "https://ionicframework.com/",
  "scripts": {
    "ng": "ng",
    "start": "bash scripts/dev-proxy.sh",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:dev": "ng serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "ng lint",
    "test:e2e": "bash scripts/test-e2e.sh",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "proxy": "bun run ../proxy/src/index.ts",
    "proxy:build": "ng build && bun run ../proxy/src/index.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.3.23",
    "@angular/compiler": "^20.3.23",
    "@angular/core": "^20.3.23",
    "@angular/forms": "^20.3.23",
    "@angular/platform-browser": "^20.3.23",
    "@angular/platform-browser-dynamic": "^20.3.23",
    "@angular/router": "^20.3.23",
    "@capacitor/android": "^8.4.2",
    "@capacitor/core": "8.3.4",
    "@ionic/angular": "^8.0.0",
    "@tanstack/angular-query-experimental": "^5.100.14",
    "hls.js": "^1.6.16",
    "ionicons": "^7.0.0",
    "plyr": "^3.8.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^3.0.0-alpha.57",
    "@angular-devkit/build-angular": "^20.3.26",
    "@angular/cli": "^20.3.26",
    "@angular/compiler-cli": "^20.3.23",
    "@capacitor/cli": "8.3.4",
    "@ionic/angular-toolkit": "^12.0.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/angular": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9.16.0",
    "fallow": "^2.89.0",
    "happy-dom": "^20.9.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.7",
    "zone.js": "^0.16.2"
  },
  "description": "An Ionic project"
}
